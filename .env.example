# Runtime connection: use the Neon pooled hostname and the existing `neondb` database.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI/migrations: use Neon's direct, non-pooled hostname.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate a long random value for the one-time initial workspace setup.
INNWEB_SETUP_TOKEN="replace-with-a-long-random-secret"
