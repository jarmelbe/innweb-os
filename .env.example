# Runtime connection: use Neon's pooled hostname (contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/innweb_os?sslmode=require"

# Prisma CLI/migrations: use Neon's direct, non-pooled hostname.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/innweb_os?sslmode=require"

# Generate a long random value for the one-time initial workspace setup.
INNWEB_SETUP_TOKEN="replace-with-a-long-random-secret"
